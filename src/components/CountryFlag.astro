---
interface Props {
  slug: string;
  label: string;
  size?: 'sm' | 'md';
}

const { slug, label, size = 'md' } = Astro.props;
---

<span class:list={['country-flag', `country-flag--${slug}`, `country-flag--${size}`]} role="img" aria-label={label}></span>

<style>
  .country-flag {
    position: relative;
    display: inline-block;
    flex: 0 0 auto;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.2);
  }

  .country-flag--sm {
    width: 1.5rem;
    height: 1rem;
    border-radius: 0.18rem;
  }

  .country-flag--md {
    width: 2rem;
    height: 1.35rem;
    border-radius: 0.24rem;
  }

  .country-flag--deutschland {
    background: linear-gradient(to bottom, #111827 0 33.33%, #dc2626 33.33% 66.66%, #facc15 66.66% 100%);
  }

  .country-flag--oesterreich {
    background: linear-gradient(to bottom, #dc2626 0 33.33%, #ffffff 33.33% 66.66%, #dc2626 66.66% 100%);
  }

  .country-flag--schweiz {
    background: #dc2626;
  }

  .country-flag--schweiz::before,
  .country-flag--schweiz::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    background: #ffffff;
    transform: translate(-50%, -50%);
  }

  .country-flag--schweiz::before {
    width: 52%;
    height: 18%;
  }

  .country-flag--schweiz::after {
    width: 18%;
    height: 52%;
  }

  .country-flag--usa {
    background:
      linear-gradient(to bottom,
        #b91c1c 0 7.69%,
        #ffffff 7.69% 15.38%,
        #b91c1c 15.38% 23.07%,
        #ffffff 23.07% 30.76%,
        #b91c1c 30.76% 38.45%,
        #ffffff 38.45% 46.14%,
        #b91c1c 46.14% 53.83%,
        #ffffff 53.83% 61.52%,
        #b91c1c 61.52% 69.21%,
        #ffffff 69.21% 76.9%,
        #b91c1c 76.9% 84.59%,
        #ffffff 84.59% 92.28%,
        #b91c1c 92.28% 100%);
  }

  .country-flag--usa::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 42%;
    height: 54%;
    background: #1e3a8a;
  }

  .country-flag--italija {
    background: linear-gradient(to right, #15803d 0 33.33%, #ffffff 33.33% 66.66%, #dc2626 66.66% 100%);
  }

  .country-flag--spanija {
    background: linear-gradient(to bottom, #b91c1c 0 25%, #facc15 25% 75%, #b91c1c 75% 100%);
  }

  .country-flag--velika-britanija {
    background:
      linear-gradient(33deg, transparent 0 42%, #ffffff 42% 48%, #dc2626 48% 52%, #ffffff 52% 58%, transparent 58%),
      linear-gradient(-33deg, transparent 0 42%, #ffffff 42% 48%, #dc2626 48% 52%, #ffffff 52% 58%, transparent 58%),
      linear-gradient(to right, transparent 0 42%, #ffffff 42% 58%, transparent 58%),
      linear-gradient(to bottom, transparent 0 38%, #ffffff 38% 62%, transparent 62%),
      #1e3a8a;
  }

  .country-flag--velika-britanija::before {
    content: "";
    position: absolute;
    inset: 42% 0 auto 0;
    height: 16%;
    background: #dc2626;
  }

  .country-flag--velika-britanija::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 44%;
    width: 12%;
    background: #dc2626;
  }

  .country-flag--australia {
    background: #1e3a8a;
  }

  .country-flag--australia::before {
    content: "";
    position: absolute;
    top: 12%;
    right: 16%;
    width: 22%;
    height: 22%;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: -0.42rem 0.34rem 0 -0.06rem #ffffff, 0.22rem 0.52rem 0 -0.08rem #ffffff;
  }

  .country-flag--australia::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 46%;
    height: 54%;
    background:
      linear-gradient(to right, transparent 0 40%, #ffffff 40% 60%, transparent 60%),
      linear-gradient(to bottom, transparent 0 40%, #ffffff 40% 60%, transparent 60%),
      #1e3a8a;
  }

  .country-flag--belgija {
    background: linear-gradient(to right, #111827 0 33.33%, #facc15 33.33% 66.66%, #dc2626 66.66% 100%);
  }

  .country-flag--francuska {
    background: linear-gradient(to right, #1d4ed8 0 33.33%, #ffffff 33.33% 66.66%, #dc2626 66.66% 100%);
  }

  .country-flag--svedska {
    background:
      linear-gradient(to right, transparent 0 30%, #facc15 30% 42%, transparent 42%),
      linear-gradient(to bottom, transparent 0 40%, #facc15 40% 58%, transparent 58%),
      #2563eb;
  }

  .country-flag--finska {
    background:
      linear-gradient(to right, transparent 0 32%, #2563eb 32% 44%, transparent 44%),
      linear-gradient(to bottom, transparent 0 40%, #2563eb 40% 58%, transparent 58%),
      #ffffff;
  }

  .country-flag--norveska {
    background:
      linear-gradient(to right, transparent 0 28%, #ffffff 28% 44%, transparent 44%),
      linear-gradient(to bottom, transparent 0 34%, #ffffff 34% 66%, transparent 66%),
      #dc2626;
  }

  .country-flag--norveska::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 33%;
    width: 6%;
    background: #1e3a8a;
  }

  .country-flag--norveska::after {
    content: "";
    position: absolute;
    inset: 44% 0 auto 0;
    height: 12%;
    background: #1e3a8a;
  }

  .country-flag--hollandija {
    background: linear-gradient(to bottom, #b91c1c 0 33.33%, #ffffff 33.33% 66.66%, #1d4ed8 66.66% 100%);
  }

  .country-flag--exyu {
    background: linear-gradient(135deg, #1d4ed8 0 33%, #ffffff 33% 38%, #dc2626 38% 66%, #ffffff 66% 71%, #facc15 71% 100%);
  }
</style>
