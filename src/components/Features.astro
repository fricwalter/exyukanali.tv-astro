---
const features = [
  {
    title: "Stabilan IPTV stream",
    description:
      "Za sport, filmove i domaće kanale bitna je stabilna veza. EXYU IPTV je podešen za svakodnevno gledanje na TV-u, bez stalnog traženja novih linkova.",
    href: "/blog/kako-poboljsati-kvalitetu-iptv-streama/",
    linkLabel: "Kako poboljšati stream"
  },
  {
    title: "Sport i Catch TV",
    description:
      "Gledaj utakmice uživo, a kada zakasniš zbog posla ili puta, koristi Catch TV za propuštene emisije gdje je dostupan.",
    href: "/blog/najbolji-sportski-kanali-exyu-iptv/",
    linkLabel: "Sport vodič"
  },
  {
    title: "Radi na tvojim uređajima",
    description:
      "Smart TV, Fire TV Stick, Android Box, telefon, tablet i laptop. Izabereš uređaj, dobiješ upute i možeš krenuti bez komplikacije.",
    href: "/instalacija/",
    linkLabel: "Vodiči za instalaciju"
  },
  {
    title: "Bez ugovorne obaveze",
    description:
      "Nema kablovskog ugovora, satelitske montaže ili dugog vezivanja. Kreni s 24h testom i provjeri uslugu na svom uređaju.",
    href: "/narudzba/",
    linkLabel: "Pokreni 24h test"
  },
  {
    title: "Domaći kanali za dijasporu",
    description:
      "Bosanski, srpski, hrvatski i regionalni program za ljude koji žive u Njemačkoj, Austriji, Švicarskoj i širom inostranstva.",
    href: "/blog/kako-gledati-exyu-kanale-u-inostranstvu/",
    linkLabel: "EXYU kanali vani"
  },
  {
    title: "Podrška preko WhatsAppa i Vibera",
    description:
      "Ako ne znaš koju aplikaciju koristiti ili gdje upisati podatke, pošalji model uređaja i dobit ćeš jasnu pomoć.",
    href: "/kontakt/",
    linkLabel: "Kontaktiraj podršku"
  }
];

const stats = [
  { value: "24h", label: "test prije paketa" },
  { value: "0", label: "dugih ugovora" },
  { value: "6+", label: "tipova uređaja" },
  { value: "Catch TV", label: "za propušteno" }
];
---

<section id="features" class="relative overflow-hidden py-20 bg-slate-950">
  <div class="absolute inset-0">
    <img src="/images/hero-bg-compressed.webp" alt="" class="h-full w-full object-cover opacity-10" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-blue-950/70 to-slate-950"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[0.95fr_1.05fr] gap-10 items-end mb-12">
      <div>
        <p class="text-sm font-black uppercase tracking-wide text-amber-300 mb-3">Prednosti</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight">
          Zašto ljudi biraju EXYU IPTV
        </h2>
      </div>
      <div>
        <p class="text-lg text-slate-300 leading-8">
          Fokus je jednostavan: domaći kanali, sport, filmovi i podrška na našem jeziku, bez satelita i bez kablovskog ugovora.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/iptv/deutschland/" class="rounded-full border border-white/10 bg-white/[0.06] px-4 py-2 text-sm font-bold text-slate-200 hover:border-amber-300/40 hover:text-amber-300 transition">
            IPTV Deutschland
          </a>
          <a href="/narudzba/" class="rounded-full border border-white/10 bg-white/[0.06] px-4 py-2 text-sm font-bold text-slate-200 hover:border-amber-300/40 hover:text-amber-300 transition">
            24h test
          </a>
          <a href="/kontakt/" class="rounded-full border border-white/10 bg-white/[0.06] px-4 py-2 text-sm font-bold text-slate-200 hover:border-amber-300/40 hover:text-amber-300 transition">
            WhatsApp / Viber
          </a>
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-6">
      <div class="rounded-2xl border border-amber-300/20 bg-gradient-to-br from-amber-300/12 to-blue-500/10 p-6 sm:p-8">
        <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight">
          Sve što trebaš za TV iz domovine na jednom mjestu
        </h3>
        <p class="mt-4 text-slate-300 leading-8">
          Umjesto više aplikacija, linkova i nejasnih podešavanja, dobijaš jedan IPTV pristup za svakodnevno gledanje na uređaju koji već imaš.
        </p>
        <div class="mt-7 grid grid-cols-2 gap-3">
          {stats.map((item) => (
            <div class="rounded-xl border border-white/10 bg-slate-950/55 p-4">
              <p class="text-xl font-black text-amber-300">{item.value}</p>
              <p class="mt-1 text-xs font-semibold text-slate-300">{item.label}</p>
            </div>
          ))}
        </div>
        <a href="/narudzba/" class="mt-7 inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-yellow-500 to-orange-500 px-6 py-3 font-black text-slate-950 shadow-lg shadow-orange-500/25 hover:shadow-orange-500/35 transition">
          Testiraj prije paketa
        </a>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        {features.map((feature) => (
          <a
            href={feature.href}
            class="group rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-xl shadow-blue-950/10 hover:border-amber-300/40 hover:bg-white/[0.09] transition"
          >
            <div class="mb-4 flex h-9 w-9 items-center justify-center rounded-full bg-amber-300 text-sm font-black text-slate-950">
              ✓
            </div>
            <h3 class="text-xl font-black text-white leading-snug">{feature.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-300">{feature.description}</p>
            <span class="mt-5 inline-flex text-sm font-black text-amber-300 group-hover:text-amber-200">
              {feature.linkLabel} →
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
