---
interface SchemaData {
  title?: string;
  description?: string;
  url?: string;
  author?: string;
  pubDate?: string | Date;
  updatedDate?: string | Date;
  image?: string;
  faqs?: Array<{ question: string; answer: string }>;
  phone?: string;
  openingHours?: string[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  category?: string;
  brand?: string;
  offers?: Array<{
    name?: string;
    price: string;
    priceCurrency?: string;
    url?: string;
    availability?: string;
    priceValidUntil?: string;
  }>;
}

interface Props {
  type?: 'WebPage' | 'WebSite' | 'BlogPosting' | 'Organization' | 'FAQPage' | 'BreadcrumbList' | 'Product' | 'LocalBusiness';
  data: SchemaData;
}

const { type = 'WebPage', data } = Astro.props;

const toISODate = (value?: string | Date) => {
  if (!value) return undefined;
  if (value instanceof Date) return value.toISOString();

  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return undefined;
  return parsed.toISOString();
};

const schema = {
  '@context': 'https://schema.org',
  '@type': type,
  ...(type === 'Organization' && {
    name: data.title ?? 'EXYU Kanali TV',
    description: data.description,
    url: data.url,
    logo: {
      '@type': 'ImageObject',
      url: 'https://exyukanali.tv/logo.svg'
    }
  }),
  ...(type === 'WebPage' && {
    name: data.title,
    description: data.description,
    url: data.url
  }),
  ...(type === 'WebSite' && {
    name: data.title ?? 'EXYU Kanali TV',
    description: data.description,
    url: data.url
  }),
  ...(type === 'BlogPosting' && {
    headline: data.title,
    name: data.title,
    description: data.description,
    url: data.url,
    author: {
      '@type': 'Person',
      name: data.author ?? 'EXYU Kanali TV'
    },
    datePublished: toISODate(data.pubDate),
    dateModified: toISODate(data.updatedDate ?? data.pubDate),
    publisher: {
      '@type': 'Organization',
      name: 'EXYU Kanali TV',
      logo: {
        '@type': 'ImageObject',
        url: 'https://exyukanali.tv/logo.svg'
      }
    },
    ...(data.image && {
      image: {
        '@type': 'ImageObject',
        url: data.image
      }
    }),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': data.url
    }
  }),
  ...(type === 'FAQPage' && {
    mainEntity: (data.faqs ?? []).map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer
      }
    }))
  }),
  ...(type === 'BreadcrumbList' && {
    itemListElement: (data.breadcrumbs ?? []).map((breadcrumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: breadcrumb.name,
      item: breadcrumb.url
    }))
  }),
  ...(type === 'Product' && {
    name: data.title,
    description: data.description,
    image: data.image,
    category: data.category,
    brand: {
      '@type': 'Brand',
      name: data.brand ?? 'EXYU Kanali TV'
    },
    url: data.url,
    offers: (data.offers ?? []).map((offer) => ({
      '@type': 'Offer',
      name: offer.name,
      price: offer.price,
      priceCurrency: offer.priceCurrency ?? 'EUR',
      url: offer.url ?? data.url,
      availability: offer.availability ?? 'https://schema.org/InStock',
      priceValidUntil: offer.priceValidUntil ?? '2035-12-31'
    }))
  }),
  ...(type === 'LocalBusiness' && {
    name: data.title ?? 'EXYU Kanali TV',
    description: data.description,
    url: data.url,
    image: data.image,
    telephone: data.phone,
    openingHours: data.openingHours,
    areaServed: ['DE', 'AT', 'CH'],
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: data.phone,
        contactType: 'customer support',
        areaServed: ['DE', 'AT', 'CH'],
        availableLanguage: ['bs', 'sr', 'hr', 'de']
      }
    ]
  })
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
