---
const stats = [
  { label: "24h", value: "Test prije paketa" },
  { label: "0", value: "Ugovora" },
  { label: "Catch TV", value: "Propušteno vratiš" },
  { label: "4K", value: "Sport i filmovi" },
];

const features = [
  "24h test prije paketa",
  "Sport, Catch TV i VOD",
  "Podrška preko WhatsAppa i Vibera",
];

const heroLinks = [
  { href: "/iptv/deutschland/", label: "IPTV Deutschland" },
  { href: "/instalacija/", label: "Instalacija" },
  { href: "/blog/najbolji-sportski-kanali-exyu-iptv/", label: "Sport kanali" },
  { href: "/blog/", label: "Blog vodiči" },
];
---

<section id="home" class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-slate-950">
  <!-- Video Background -->
  <div class="absolute inset-0 z-0">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="none"
      poster="/images/hero-bg-compressed.webp"
      class="w-full h-full object-cover"
    >
      <source src="/hero-video.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/96 via-blue-950/90 to-slate-950/70"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(245,158,11,0.22),transparent_32%),radial-gradient(circle_at_78%_36%,rgba(14,165,233,0.18),transparent_30%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-slate-950 to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-24 md:py-20">
    <div class="grid lg:grid-cols-[1.08fr_0.92fr] gap-10 xl:gap-14 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-amber-300/30 bg-amber-300/10 text-amber-100 text-sm font-bold mb-6 shadow-lg shadow-amber-950/20">
          <span class="w-2 h-2 bg-emerald-400 rounded-full"></span>
          EXYU IPTV za dijasporu
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight mb-6">
          EXYU IPTV za dijasporu: <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-orange-400">domaći kanali, sport i filmovi</span> bez ugovora
        </h1>

        <p class="text-lg sm:text-xl text-slate-100/85 mb-8 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Gledaj bosanske, srpske, hrvatske i regionalne TV kanale u Njemačkoj, Austriji, Švicarskoj i širom inostranstva. Radi na Smart TV-u, Fire TV Sticku, Android Boxu, telefonu i laptopu.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href="/narudzba/"
            class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-amber-400 to-orange-500 text-slate-950 font-black rounded-xl shadow-lg shadow-orange-500/25 hover:shadow-xl hover:shadow-orange-500/35 hover:-translate-y-1 transition-all duration-200"
          >
            Pokreni 24h test
          </a>
          <a
            href="/instalacija/"
            class="inline-flex items-center justify-center px-8 py-4 bg-white/10 backdrop-blur-sm border border-white/20 text-white font-bold rounded-xl hover:bg-white/15 hover:border-amber-300/40 transition-all duration-200"
          >
            Provjeri uređaj
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="mt-9 flex flex-wrap gap-3 justify-center lg:justify-start">
          {features.map((feature) => (
            <div class="flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.07] px-4 py-2 text-sm font-semibold text-slate-100">
              <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
              <span>{feature}</span>
            </div>
          ))}
        </div>

        <nav class="mt-8 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-3 justify-center lg:justify-start" aria-label="Brzi linkovi">
          {heroLinks.map((link) => (
            <a href={link.href} class="rounded-lg border border-amber-300/20 bg-slate-950/35 px-3 py-2 text-center text-sm font-bold text-amber-200 hover:border-amber-300/50 hover:text-white transition">
              {link.label} <span aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </div>

      <!-- Stats Card -->
      <div class="hidden lg:block">
        <div class="relative rounded-3xl border border-white/15 bg-slate-900/55 p-6 shadow-2xl shadow-blue-950/40 backdrop-blur-md">
          <div class="rounded-2xl border border-amber-300/20 bg-gradient-to-br from-amber-300/12 to-sky-400/10 p-6 mb-6">
            <p class="text-sm font-black uppercase tracking-wide text-amber-200 mb-3">Odmah spremno za gledanje</p>
            <h2 class="text-3xl font-black text-white leading-tight mb-3">Jedna lista za TV, telefon i putovanja</h2>
            <p class="text-slate-200 leading-relaxed">
              Podrška pomaže oko instalacije, a test od 24h pokazuje kako kanali rade na tvojoj mreži prije nego uzmeš paket.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-6">
            {stats.map((stat) => (
              <div class="p-4 rounded-2xl bg-white/[0.06] border border-white/10">
                <div class="text-2xl font-black text-white mb-1">{stat.label}</div>
                <div class="text-slate-300 text-sm">{stat.value}</div>
              </div>
            ))}
          </div>

          <div class="mt-6 p-4 bg-emerald-500/15 rounded-xl border border-emerald-400/25">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 bg-emerald-400 rounded-full"></div>
              <span class="text-white font-bold">Stabilni EU serveri za Njemačku, Austriju i Švicarsku</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
