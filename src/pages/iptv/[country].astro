---
import SeoLayout from '../../layouts/SeoLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CountryFlag from '../../components/CountryFlag.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { countryPages } from '../../data/countryPages';

export function getStaticPaths() {
  return countryPages.map((country) => ({
    params: { country: country.slug },
    props: { country }
  }));
}

const { country } = Astro.props;
const relatedCountries = countryPages.filter((page) => page.slug !== country.slug);
const imageUrl = `https://exyukanali.tv${country.image}`;
const isEnglish = country.languageLabel === 'English';
const isGerman = country.languageLabel === 'Deutsch';
---

<SeoLayout
  title={country.seo.title}
  description={country.seo.description}
  canonicalURL={`https://exyukanali.tv/iptv/${country.slug}/`}
  image={imageUrl}
  imageAlt={country.imageAlt}
>
  <Navbar />
  <SchemaOrg
    type="BreadcrumbList"
    data={{
      breadcrumbs: [
        { name: 'Početna', url: 'https://exyukanali.tv/' },
        { name: `IPTV ${country.localName}`, url: `https://exyukanali.tv/iptv/${country.slug}/` }
      ]
    }}
  />
  <SchemaOrg
    type="Product"
    data={{
      title: `EXYU IPTV ${country.localName}`,
      description: country.seo.description,
      url: `https://exyukanali.tv/iptv/${country.slug}/`,
      image: imageUrl,
      category: 'IPTV Subscription',
      brand: 'EXYU Kanali TV',
      offers: [
        { name: '24h Test', price: '0', url: 'https://exyukanali.tv/narudzba/' },
        { name: 'EXYU IPTV Premium', price: '15', url: 'https://exyukanali.tv/narudzba/' }
      ]
    }}
  />

  <main class="min-h-screen bg-slate-950 text-white">
    <section class="relative overflow-hidden pt-28 pb-16 sm:pt-32 sm:pb-20">
      <div class="absolute inset-0">
        <img src="/images/hero-bg-compressed.webp" alt="" class="h-full w-full object-cover opacity-25" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-blue-950/96 via-slate-950/90 to-slate-950/70"></div>
        <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-slate-950 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-[1fr_0.9fr] gap-10 items-center">
          <div>
            <div class="mb-6 flex flex-wrap items-center gap-3">
              <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-semibold text-amber-200 backdrop-blur">
                <CountryFlag slug={country.slug} label={`${country.localName} Flagge`} size="sm" />
                <span data-copy="bks">{country.hero.eyebrowBks}</span>
                <span data-copy="local" hidden>{country.hero.eyebrowLocal}</span>
              </span>
              <div class="inline-flex rounded-full border border-white/15 bg-slate-950/60 p-1 backdrop-blur" aria-label="Sprache umschalten">
                <button type="button" class="lang-toggle active rounded-full px-4 py-2 text-sm font-bold text-slate-950 bg-amber-300" data-lang-button="bks">BKS</button>
                <button type="button" class="lang-toggle rounded-full px-4 py-2 text-sm font-bold text-slate-200" data-lang-button="local">{country.languageLabel}</button>
              </div>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight">
              <span data-copy="bks">{country.hero.titleBks}</span>
              <span data-copy="local" hidden>{country.hero.titleLocal}</span>
            </h1>
            <p class="mt-6 max-w-3xl text-lg text-slate-200 leading-8" data-copy="bks">{country.hero.introBks}</p>
            <p class="mt-6 max-w-3xl text-lg text-slate-200 leading-8" data-copy="local" hidden>{country.hero.introLocal}</p>

            <div class="mt-8 flex flex-col sm:flex-row gap-4">
              <a href="/narudzba/" class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-yellow-500 to-orange-500 px-7 py-4 font-black text-slate-950 shadow-lg shadow-orange-500/25 hover:shadow-orange-500/35 transition">
                24h Test starten
              </a>
              <a href={country.hero.secondaryCtaHref} class="inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/10 px-7 py-4 font-bold text-white hover:bg-white/15 transition">
                <span data-copy="bks">{country.hero.secondaryCtaBks}</span>
                <span data-copy="local" hidden>{country.hero.secondaryCtaLocal}</span>
              </a>
            </div>
          </div>

          <div class="relative">
            <div class="absolute -inset-4 rounded-[2rem] bg-amber-300/10 blur-2xl"></div>
            <figure class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.06] shadow-2xl shadow-blue-950/30">
              <img
                src={country.image}
                alt={country.imageAlt}
                class="w-full aspect-video object-cover"
                width="1600"
                height="900"
                loading="eager"
              />
            </figure>
          </div>
        </div>

        <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {country.stats.map((item) => (
            <div class="rounded-xl border border-white/10 bg-white/[0.07] p-5 backdrop-blur">
              <p class="text-2xl font-black text-amber-300">{item.value}</p>
              <p class="mt-1 text-sm text-slate-300" data-copy="bks">{item.labelBks}</p>
              <p class="mt-1 text-sm text-slate-300" data-copy="local" hidden>{item.labelLocal}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1.15fr_0.85fr] gap-10">
        <div class="space-y-8">
          <section class="rounded-2xl border border-white/10 bg-white/[0.06] p-6 sm:p-8 shadow-2xl shadow-blue-950/20">
            <div data-copy="bks">
              <h2 class="text-2xl sm:text-3xl font-black mb-4">{country.intro.titleBks}</h2>
              <p class="text-slate-300 leading-8">{country.intro.textBks}</p>
            </div>
            <div data-copy="local" hidden>
              <h2 class="text-2xl sm:text-3xl font-black mb-4">{country.intro.titleLocal}</h2>
              <p class="text-slate-300 leading-8">{country.intro.textLocal}</p>
            </div>
          </section>

          <section class="grid md:grid-cols-3 gap-4">
            {country.benefits.map((card) => (
              <a href={card.href ?? '/narudzba/'} class="rounded-2xl border border-white/10 bg-white/[0.06] p-6 hover:border-amber-300/40 hover:bg-white/[0.09] transition">
                <h2 class="text-xl font-black mb-3" data-copy="bks">{card.titleBks}</h2>
                <h2 class="text-xl font-black mb-3" data-copy="local" hidden>{card.titleLocal}</h2>
                <p class="text-sm leading-7 text-slate-300" data-copy="bks">{card.textBks}</p>
                <p class="text-sm leading-7 text-slate-300" data-copy="local" hidden>{card.textLocal}</p>
                {card.ctaBks && <span class="mt-5 inline-flex text-sm font-black text-amber-300" data-copy="bks">{card.ctaBks}</span>}
                {card.ctaLocal && <span class="mt-5 inline-flex text-sm font-black text-amber-300" data-copy="local" hidden>{card.ctaLocal}</span>}
              </a>
            ))}
          </section>

          <section id="sport" class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.06]">
            <div class="grid lg:grid-cols-2">
              <div class="p-6 sm:p-8">
                <div data-copy="bks">
                  <h2 class="text-2xl sm:text-3xl font-black mb-4">{country.sport.titleBks}</h2>
                  <p class="text-slate-300 leading-8 mb-6">{country.sport.textBks}</p>
                </div>
                <div data-copy="local" hidden>
                  <h2 class="text-2xl sm:text-3xl font-black mb-4">{country.sport.titleLocal}</h2>
                  <p class="text-slate-300 leading-8 mb-6">{country.sport.textLocal}</p>
                </div>
                <div class="grid gap-3">
                  {country.sport.cards.map((item) => (
                    <a href={item.href ?? '/blog/najbolji-sportski-kanali-exyu-iptv/'} class="rounded-xl border border-white/10 bg-slate-950/50 p-4 hover:border-amber-300/40 transition">
                      <p class="font-black text-white" data-copy="bks">{item.titleBks}</p>
                      <p class="font-black text-white" data-copy="local" hidden>{item.titleLocal}</p>
                      <p class="mt-1 text-sm leading-6 text-slate-300" data-copy="bks">{item.textBks}</p>
                      <p class="mt-1 text-sm leading-6 text-slate-300" data-copy="local" hidden>{item.textLocal}</p>
                    </a>
                  ))}
                </div>
              </div>
              <img
                src="/images/countries/deutschland-catch-tv.webp"
                alt="Catch TV za propuštene sportske prijenose"
                class="h-full min-h-80 w-full object-cover"
                width="1600"
                height="900"
                loading="lazy"
              />
            </div>
          </section>

          <section id="uredjaji" class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.06]">
            <img
              src="/images/countries/deutschland-geraete.webp"
              alt="EXYU IPTV radi na Smart TV, Fire TV Stick, Android Box, telefonu i tabletu"
              class="w-full aspect-video object-cover"
              width="1600"
              height="900"
              loading="lazy"
            />
            <div class="p-6 sm:p-8">
              <div data-copy="bks">
                <h2 class="text-2xl sm:text-3xl font-black mb-4">{country.devices.titleBks}</h2>
                <p class="text-slate-300 leading-8 mb-6">{country.devices.textBks}</p>
              </div>
              <div data-copy="local" hidden>
                <h2 class="text-2xl sm:text-3xl font-black mb-4">{country.devices.titleLocal}</h2>
                <p class="text-slate-300 leading-8 mb-6">{country.devices.textLocal}</p>
              </div>
              <div class="grid sm:grid-cols-2 gap-4">
                {country.devices.cards.map((device) => (
                  <a href={device.href ?? '/instalacija/'} class="rounded-xl border border-white/10 bg-slate-950/50 p-5 hover:border-amber-300/40 hover:bg-white/[0.08] transition">
                    <h3 class="font-black text-white mb-2" data-copy="bks">{device.titleBks}</h3>
                    <h3 class="font-black text-white mb-2" data-copy="local" hidden>{device.titleLocal}</h3>
                    <p class="text-sm leading-6 text-slate-300" data-copy="bks">{device.textBks}</p>
                    <p class="text-sm leading-6 text-slate-300" data-copy="local" hidden>{device.textLocal}</p>
                  </a>
                ))}
              </div>
            </div>
          </section>

          <section class="rounded-2xl border border-white/10 bg-white/[0.06] p-6 sm:p-8">
            <div data-copy="bks">
              <h2 class="text-2xl sm:text-3xl font-black mb-4">{country.connection.titleBks}</h2>
              <p class="text-slate-300 leading-8">{country.connection.textBks}</p>
            </div>
            <div data-copy="local" hidden>
              <h2 class="text-2xl sm:text-3xl font-black mb-4">{country.connection.titleLocal}</h2>
              <p class="text-slate-300 leading-8">{country.connection.textLocal}</p>
            </div>
          </section>

          <section class="rounded-2xl border border-white/10 bg-white/[0.06] p-6 sm:p-8">
            <div data-copy="bks">
              <h2 class="text-2xl sm:text-3xl font-black mb-4">{country.cities.titleBks}</h2>
              <p class="text-slate-300 leading-8 mb-6">{country.cities.textBks}</p>
            </div>
            <div data-copy="local" hidden>
              <h2 class="text-2xl sm:text-3xl font-black mb-4">{country.cities.titleLocal}</h2>
              <p class="text-slate-300 leading-8 mb-6">{country.cities.textLocal}</p>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {country.cities.items.map((city) => (
                <div id={city.id} class="rounded-xl border border-white/10 bg-slate-950/50 px-4 py-3">
                  <p class="font-bold text-white">{city.label}</p>
                  <p class="text-xs text-slate-400">{city.note}</p>
                </div>
              ))}
            </div>
          </section>
        </div>

        <aside class="space-y-6">
          <section class="rounded-2xl border border-white/10 bg-white/[0.06] p-6 lg:sticky lg:top-24">
            <h2 class="text-xl font-black mb-4 flex items-center gap-2">
              <CountryFlag slug={country.slug} label={`${country.localName} Flagge`} size="sm" />
              <span>IPTV {country.localName}</span>
            </h2>
            <div class="grid grid-cols-2 gap-2 mb-6">
              {country.cities.items.map((city) => (
                <a href={`/iptv/${country.slug}/#${city.id}`} class="rounded-lg bg-slate-950/60 px-3 py-2 text-sm text-slate-200 hover:text-amber-300 transition">
                  {city.label}
                </a>
              ))}
            </div>
            <div class="space-y-3">
              <a href="/narudzba/" class="block rounded-xl bg-gradient-to-r from-yellow-500 to-orange-500 px-5 py-3 text-center font-black text-slate-950">24h Test starten</a>
              <a href="/instalacija/" class="block rounded-xl border border-white/15 bg-white/10 px-5 py-3 text-center font-bold text-white hover:bg-white/15">Installation</a>
              <a href="/kontakt/" class="block rounded-xl border border-white/15 bg-white/10 px-5 py-3 text-center font-bold text-white hover:bg-white/15">WhatsApp Kontakt</a>
            </div>
          </section>

          <section class="rounded-2xl border border-white/10 bg-white/[0.06] p-6">
            <h2 class="text-xl font-black mb-4">{isGerman ? 'Weitere Länder' : 'More countries'}</h2>
            <div class="grid gap-2">
              {relatedCountries.map((related) => (
                <a href={`/iptv/${related.slug}/`} class="rounded-lg bg-slate-950/60 px-3 py-2 text-sm font-bold text-slate-200 hover:text-amber-300 transition">
                  <span class="inline-flex items-center gap-2">
                    <CountryFlag slug={related.slug} label={`${related.localName} Flagge`} size="sm" />
                    <span>IPTV {related.localName}</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        </aside>
      </div>
    </section>

    <section class="pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-6 sm:p-8">
          <div data-copy="bks">
            <h2 class="text-2xl sm:text-3xl font-black mb-4">Korisni vodiči za {country.bksName}</h2>
            <p class="text-slate-300 leading-8 mb-6">
              Ako želiš detalje prije narudžbe, kreni od ovih vodiča. Svaki link vodi na konkretan problem: uređaj, sport, stabilnost, aplikacija ili druga zemlja.
            </p>
          </div>
          <div data-copy="local" hidden>
            <h2 class="text-2xl sm:text-3xl font-black mb-4">{isGerman ? `Nützliche Guides für ${country.localName}` : `Useful guides for ${country.localName}`}</h2>
            <p class="text-slate-300 leading-8 mb-6">
              {isGerman
                ? 'Wenn du vor der Bestellung Details brauchst, starte mit diesen Guides. Jeder Link führt zu einem konkreten Thema: Gerät, Sport, Stabilität, App oder ein anderes Land.'
                : 'If you want details before ordering, start with these guides. Each link points to a concrete topic: device, sports, stability, app setup or another country.'}
            </p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {country.guides.map((link) => (
              <a href={link.href} class="rounded-xl border border-white/10 bg-slate-950/50 p-5 hover:border-amber-300/40 hover:bg-white/[0.08] transition">
                <p class="font-black text-white" data-copy="bks">{link.labelBks}</p>
                <p class="font-black text-white" data-copy="local" hidden>{link.labelLocal}</p>
                <p class="mt-2 text-sm leading-6 text-slate-300" data-copy="bks">{link.textBks}</p>
                <p class="mt-2 text-sm leading-6 text-slate-300" data-copy="local" hidden>{link.textLocal}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-4">
          {country.faq.map((item) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.06] p-6">
              <h2 class="text-xl font-black mb-3" data-copy="bks">{item.titleBks}</h2>
              <h2 class="text-xl font-black mb-3" data-copy="local" hidden>{item.titleLocal}</h2>
              <p class="text-slate-300 leading-7" data-copy="bks">{item.textBks}</p>
              <p class="text-slate-300 leading-7" data-copy="local" hidden>{item.textLocal}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-amber-300/20 bg-gradient-to-br from-amber-300/12 to-blue-500/10 p-6 sm:p-8">
          <div data-copy="bks">
            <h2 class="text-2xl sm:text-3xl font-black mb-4">Ako želiš gledati večeras, kreni s testom</h2>
            <p class="text-slate-200 leading-8 mb-6">
              Ne treba ti novi ugovor, satelitska antena ni čekanje tehničara. Izaberi test, pošalji uređaj koji koristiš i dobit ćeš podatke za pokretanje.
            </p>
          </div>
          <div data-copy="local" hidden>
            <h2 class="text-2xl sm:text-3xl font-black mb-4">{isGerman ? 'Wenn du heute Abend schauen willst, starte mit dem Test' : 'If you want to watch tonight, start with the test'}</h2>
            <p class="text-slate-200 leading-8 mb-6">
              {isGerman
                ? 'Du brauchst keinen neuen Vertrag, keine Satellitenschüssel und keinen Technikertermin. Test auswählen, Gerät nennen und Zugangsdaten erhalten.'
                : 'You do not need a new contract, satellite dish or technician visit. Choose the test, tell us your device and get the access details.'}
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/narudzba/" class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-yellow-500 to-orange-500 px-7 py-4 font-black text-slate-950">24h Test starten</a>
            <a href="/kontakt/" class="inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/10 px-7 py-4 font-bold text-white hover:bg-white/15">{isGerman ? 'Erst fragen' : 'Ask first'}</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</SeoLayout>

<script>
  const buttons = document.querySelectorAll('[data-lang-button]');
  const copyBlocks = document.querySelectorAll('[data-copy]');

  function setLanguage(lang) {
    copyBlocks.forEach((block) => {
      block.hidden = block.getAttribute('data-copy') !== lang;
    });

    buttons.forEach((button) => {
      const active = button.getAttribute('data-lang-button') === lang;
      button.classList.toggle('active', active);
      button.classList.toggle('bg-amber-300', active);
      button.classList.toggle('text-slate-950', active);
      button.classList.toggle('text-slate-200', !active);
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      setLanguage(button.getAttribute('data-lang-button') ?? 'bks');
    });
  });
</script>
