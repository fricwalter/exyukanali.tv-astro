---
import SeoLayout from '../../layouts/SeoLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { blogPosts } from '../../data/blogPosts';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const seoTitle =
  post.title.length > 60
    ? `${post.title.slice(0, 57).trimEnd()}...`
    : post.title.length > 47
      ? post.title
      : `${post.title} | EXYU IPTV`;
const seoDescription =
  post.excerpt.length >= 120
    ? post.excerpt
    : `${post.excerpt} Saznajte vise, uporedite opcije i pokrenite EXYU IPTV bez komplikacija.`;
const publishedTime = new Date(post.date).toISOString();
---

<SeoLayout
  title={seoTitle}
  description={seoDescription}
  canonicalURL={`https://exyukanali.tv/blog/${post.slug}/`}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={publishedTime}
  imageAlt={post.title}
>
  <Navbar />
  <SchemaOrg
    type="BlogPosting"
    data={{
      title: post.title,
      description: seoDescription,
      url: `https://exyukanali.tv/blog/${post.slug}/`,
      pubDate: post.date,
      updatedDate: post.date,
      image: 'https://exyukanali.tv/og-image.jpg',
      author: 'EXYU Kanali TV'
    }}
  />
  <SchemaOrg
    type="BreadcrumbList"
    data={{
      breadcrumbs: [
        { name: 'Pocetna', url: 'https://exyukanali.tv/' },
        { name: 'Blog', url: 'https://exyukanali.tv/blog/' },
        { name: post.title, url: `https://exyukanali.tv/blog/${post.slug}/` }
      ]
    }}
  />

  <main class="pt-24 pb-20 bg-white min-h-screen">
    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
        <a href="/" class="hover:text-blue-600">Pocetna</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-blue-600">Blog</a>
        <span>/</span>
        <span class="text-gray-900">{post.title}</span>
      </nav>

      <header class="mb-12">
        <div class="flex items-center gap-4 mb-4">
          <span class="px-3 py-1 bg-blue-100 text-blue-600 text-sm font-semibold rounded-full">
            {post.category}
          </span>
          <time datetime={post.date} class="text-gray-500 text-sm">
            {new Date(post.date).toLocaleDateString('de-DE')}
          </time>
          <span class="text-gray-500 text-sm">•</span>
          <span class="text-gray-500 text-sm">{post.readTime} citanja</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">
          {post.title}
        </h1>
      </header>

      <div class="prose prose-lg max-w-none text-gray-700" set:html={post.content} />

      <!-- CTA Box -->
      <div class="mt-12 p-6 bg-blue-50 border border-blue-200 rounded-2xl">
        <h3 class="text-xl font-bold text-gray-900 mb-2">Spreman/na za EXYU IPTV?</h3>
        <p class="text-gray-600 mb-4">Isprobaj 24 sata besplatno. Bez ugovora, bez rizika.</p>
        <a
          href="/narudzba/"
          class="inline-block px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors"
        >
          Naruci IPTV &rarr;
        </a>
      </div>

      <div class="mt-10 pt-8 border-t border-gray-200">
        <p class="font-semibold text-gray-900 mb-4">Podijelite ovaj clanak:</p>
        <div class="flex gap-4">
          <a
            href={`https://wa.me/4915251741280?text=${encodeURIComponent(post.title + ' - https://exyukanali.tv/blog/' + post.slug + '/')}`}
            class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent('https://exyukanali.tv/blog/' + post.slug + '/')}`}
            class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook
          </a>
        </div>
      </div>

      <RelatedPosts currentSlug={post.slug} currentCategory={post.category} />

      <div class="mt-12">
        <a href="/blog/" class="inline-flex items-center gap-2 text-blue-600 font-semibold hover:gap-3 transition-all">
          &larr; Nazad na blog
        </a>
      </div>
    </article>
  </main>

  <Footer />
</SeoLayout>
