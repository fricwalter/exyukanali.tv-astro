---
import SeoLayout from '../../layouts/SeoLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { blogPosts } from '../../data/blogPosts';

const posts = [...blogPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const getBlogImage = (slug: string) => `/images/blog/${slug}.webp`;
---

<SeoLayout
  title="EXYU IPTV Blog | Vodici, Savjeti i Novosti"
  description="Procitajte vodice za instalaciju IPTV-a, savjete za stabilniji streaming i preporuke za uredaje. Posjetite blog i saznajte vise."
  canonicalURL="https://exyukanali.tv/blog/"
>
  <Navbar />

  <main class="min-h-screen bg-slate-950 text-white">
    <section class="relative overflow-hidden pt-28 pb-16 sm:pt-32 sm:pb-20">
      <div class="absolute inset-0">
        <img
          src="/images/hero-bg-compressed.webp"
          alt=""
          class="h-full w-full object-cover opacity-30"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-blue-950/95 via-blue-950/85 to-slate-950/75"></div>
        <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-slate-950 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="mb-5 inline-flex rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-semibold text-amber-200 backdrop-blur">
            EXYU IPTV Blog
          </p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight">
            Vodici za stabilno gledanje domacih kanala iz dijaspore
          </h1>
          <p class="mt-6 max-w-2xl text-lg text-slate-200">
            Instalacija, uredaji, aplikacije i prakticni savjeti za EXYU IPTV bez gubljenja vremena.
          </p>
        </div>
      </div>
    </section>

    <section class="relative -mt-6 pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <article class="group overflow-hidden rounded-2xl border border-white/10 bg-white/[0.06] shadow-2xl shadow-blue-950/20 backdrop-blur transition duration-300 hover:-translate-y-1 hover:border-amber-300/40 hover:bg-white/[0.09]">
              <a href={`/blog/${post.slug}/`} class="block h-48 bg-slate-900 overflow-hidden">
                <img
                  src={getBlogImage(post.slug)}
                  alt={post.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  width="800"
                  height="450"
                />
              </a>
              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class="px-3 py-1 bg-blue-500/15 text-blue-200 text-xs font-semibold rounded-full ring-1 ring-blue-300/15">
                    {post.category}
                  </span>
                  <time datetime={post.date} class="text-slate-400 text-sm">
                    {new Date(post.date).toLocaleDateString('de-DE')}
                  </time>
                </div>
                <h2 class="text-xl font-bold text-white mb-3 line-clamp-2">
                  <a href={`/blog/${post.slug}/`} class="hover:text-amber-300 transition-colors">
                    {post.title}
                  </a>
                </h2>
                <p class="text-slate-300 text-sm mb-4 line-clamp-3">{post.excerpt}</p>
                <a
                  href={`/blog/${post.slug}/`}
                  class="inline-flex items-center gap-2 text-amber-300 font-semibold hover:gap-3 transition-all"
                >
                  Procitaj vise
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</SeoLayout>
