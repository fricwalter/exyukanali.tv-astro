---
import SeoLayout from '../layouts/SeoLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const packages = [
  { name: "Standard - 1 Mjesec", price: "10€", value: "standard-1" },
  { name: "Standard - 3 Mjeseca", price: "25€", value: "standard-3" },
  { name: "Standard - 6 Mjeseci", price: "45€", value: "standard-6" },
  { name: "Standard - 12 Mjeseci", price: "60€", value: "standard-12" },
  { name: "Premium - 1 Mjesec", price: "15€", value: "premium-1" },
  { name: "Premium - 3 Mjeseca", price: "40€", value: "premium-3" },
  { name: "Premium - 6 Mjeseci", price: "60€", value: "premium-6" },
  { name: "Premium - 12 Mjeseci", price: "84€", value: "premium-12" },
  { name: "Test - 24 sata", price: "BESPLATNO", value: "test" },
];

const devices = [
  "Smart TV (Samsung/LG)",
  "Android Box",
  "Amazon Fire TV Stick",
  "Apple TV / iOS",
  "Android Telefon/Tablet",
  "PC / Laptop",
  "MAG / Enigma2",
  "Drugo"
];
---

<SeoLayout
  title="Naruci EXYU IPTV | Pretplata, Test i Aktivacija"
  description="Narucite EXYU IPTV pretplatu ili besplatan test danas. Odaberite paket, ispunite formular i aktivirajte gledanje za par minuta."
  canonicalURL="https://exyukanali.tv/narudzba/"
>
  <Navbar />
  <SchemaOrg
    type="Product"
    data={{
      title: 'EXYU IPTV Pretplata',
      description: 'IPTV pretplata za dijasporu sa EXYU kanalima, sportom, VOD sadrzajem i podrskom za sve glavne uredaje.',
      url: 'https://exyukanali.tv/narudzba/',
      image: 'https://exyukanali.tv/og-image.jpg',
      category: 'IPTV Subscription',
      offers: [
        { name: 'Standard - 1 Mjesec', price: '10', url: 'https://exyukanali.tv/narudzba/' },
        { name: 'Standard - 3 Mjeseca', price: '25', url: 'https://exyukanali.tv/narudzba/' },
        { name: 'Standard - 6 Mjeseci', price: '45', url: 'https://exyukanali.tv/narudzba/' },
        { name: 'Standard - 12 Mjeseci', price: '60', url: 'https://exyukanali.tv/narudzba/' },
        { name: 'Premium - 1 Mjesec', price: '15', url: 'https://exyukanali.tv/narudzba/' },
        { name: 'Premium - 3 Mjeseca', price: '40', url: 'https://exyukanali.tv/narudzba/' },
        { name: 'Premium - 6 Mjeseci', price: '60', url: 'https://exyukanali.tv/narudzba/' },
        { name: 'Premium - 12 Mjeseci', price: '84', url: 'https://exyukanali.tv/narudzba/' }
      ]
    }}
  />
  <SchemaOrg
    type="BreadcrumbList"
    data={{
      breadcrumbs: [
        { name: 'Pocetna', url: 'https://exyukanali.tv/' },
        { name: 'Narudzba', url: 'https://exyukanali.tv/narudzba/' }
      ]
    }}
  />

  <main class="relative overflow-hidden pt-28 pb-20 bg-slate-950 text-white min-h-screen">
    <div class="absolute inset-0">
      <img src="/images/hero-bg-compressed.webp" alt="" class="h-full w-full object-cover opacity-20" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-blue-950/92 via-slate-950/95 to-slate-950"></div>
      <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-blue-900/25 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-green-500/15 text-green-200 ring-1 ring-green-300/25 rounded-full text-sm font-bold mb-6">
          <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
          🎁 Besplatan test 24h
        </div>
        <h1 class="text-4xl sm:text-5xl font-black text-white mb-4">
          Naruči <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-orange-500">Sada</span>
        </h1>
        <p class="text-lg text-slate-300 leading-8">
          Ispunite formular ispod i dobit ćete pristupne podatke u roku od par minuta
        </p>
      </div>

      <!-- Form -->
      <form class="rounded-3xl border border-white/10 bg-white/[0.06] p-6 sm:p-8 shadow-2xl shadow-blue-950/30 backdrop-blur" action="mailto:info@exyukanali.tv" method="post" enctype="text/plain">
        <div class="space-y-6">
          <!-- Name -->
          <div>
            <label for="name" class="block text-sm font-bold text-slate-200 mb-2">
              Ime i Prezime *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 rounded-xl border border-white/10 bg-slate-950/65 text-white placeholder:text-slate-500 focus:border-amber-300 focus:ring-2 focus:ring-amber-300/25 transition-all outline-none"
              placeholder="Unesite vaše ime i prezime"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-bold text-slate-200 mb-2">
              Email Adresa *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-xl border border-white/10 bg-slate-950/65 text-white placeholder:text-slate-500 focus:border-amber-300 focus:ring-2 focus:ring-amber-300/25 transition-all outline-none"
              placeholder="vas.email@example.com"
            />
          </div>

          <!-- Phone -->
          <div>
            <label for="phone" class="block text-sm font-bold text-slate-200 mb-2">
              Telefon (WhatsApp) *
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              class="w-full px-4 py-3 rounded-xl border border-white/10 bg-slate-950/65 text-white placeholder:text-slate-500 focus:border-amber-300 focus:ring-2 focus:ring-amber-300/25 transition-all outline-none"
              placeholder="+49 1525 1741280"
            />
          </div>

          <!-- Device -->
          <div>
            <label for="device" class="block text-sm font-bold text-slate-200 mb-2">
              Uređaj *
            </label>
            <select
              id="device"
              name="device"
              required
              class="w-full px-4 py-3 rounded-xl border border-white/10 bg-slate-950/65 text-white focus:border-amber-300 focus:ring-2 focus:ring-amber-300/25 transition-all outline-none"
            >
              <option value="">Odaberite uređaj</option>
              {devices.map((device) => (
                <option value={device}>{device}</option>
              ))}
            </select>
          </div>

          <!-- Package -->
          <div>
            <label for="package" class="block text-sm font-bold text-slate-200 mb-2">
              Paket *
            </label>
            <select
              id="package"
              name="package"
              required
              class="w-full px-4 py-3 rounded-xl border border-white/10 bg-slate-950/65 text-white focus:border-amber-300 focus:ring-2 focus:ring-amber-300/25 transition-all outline-none"
            >
              <option value="">Odaberite paket</option>
              {packages.map((pkg) => (
                <option value={pkg.value}>{pkg.name} - {pkg.price}</option>
              ))}
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-sm font-bold text-slate-200 mb-2">
              Poruka (Opciono)
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full px-4 py-3 rounded-xl border border-white/10 bg-slate-950/65 text-white placeholder:text-slate-500 focus:border-amber-300 focus:ring-2 focus:ring-amber-300/25 transition-all outline-none resize-none"
              placeholder="Dodatna pitanja ili napomene..."
            ></textarea>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full py-4 bg-gradient-to-r from-yellow-500 to-orange-500 text-slate-950 font-black rounded-xl shadow-lg shadow-orange-500/25 hover:shadow-xl hover:shadow-orange-500/30 hover:-translate-y-1 transition-all duration-200"
          >
            Naruči Sada 🚀
          </button>

          <p class="text-center text-sm text-slate-400">
            Podaci su sigurni. Ne dijelimo ih sa trećim stranama.
          </p>
        </div>
      </form>

      <!-- Contact CTA -->
      <div class="mt-12 text-center">
        <p class="text-slate-300">
          Ili nas kontaktirajte direktno:
        </p>
        <div class="flex justify-center gap-4 mt-4">
          <a
            href="https://wa.me/4915251741280"
            class="inline-flex items-center gap-2 px-6 py-3 bg-green-500 text-white font-semibold rounded-xl hover:bg-green-600 transition-colors"
          >
            💬 WhatsApp
          </a>
          <a
            href="mailto:info@exyukanali.tv"
            class="inline-flex items-center gap-2 px-6 py-3 border border-white/15 bg-white/10 text-white font-bold rounded-xl hover:bg-white/15 transition-colors"
          >
            ✉️ Email
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</SeoLayout>
