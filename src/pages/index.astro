---
import SeoLayout from '../layouts/SeoLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import CategoryTabs from '../components/CategoryTabs.tsx';
import Devices from '../components/Devices.astro';
import Pricing from '../components/Pricing.tsx';
import FAQ from '../components/FAQ.tsx';
import Footer from '../components/Footer.astro';
import { blogPosts } from '../data/blogPosts';

const latestPosts = [...blogPosts]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 6);
---

<SeoLayout
  title="Exyukanali.tv | Ex-Yu TV kanali online i IPTV"
  description="Gledaj Ex-Yu TV kanale online uz EXYU IPTV. Bosanski, hrvatski i srpski programi uzivo, filmovi i sport u 4K. Isprobaj uslugu vec danas."
>
  <Navbar />
  <main>
    <p class="sr-only">EXYU IPTV kanali za dijasporu</p>
    <Hero />
    <Features />
    <section id="channels">
      <CategoryTabs client:visible />
    </section>
    <Devices />
    <Pricing client:visible />
    <FAQ client:visible />
    <section class="relative overflow-hidden py-20 bg-slate-950">
      <div class="absolute inset-0">
        <img src="/images/hero-bg-compressed.webp" alt="" class="h-full w-full object-cover opacity-10" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-blue-950/80 to-slate-950"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 class="text-3xl sm:text-4xl font-black text-white">Najnoviji Članci</h2>
          <a href="/blog/" class="shrink-0 text-amber-300 font-bold hover:text-amber-200 transition">Svi Članci →</a>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}/`}
                class="block h-full rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-xl shadow-blue-950/10 hover:border-amber-300/40 hover:bg-white/[0.09] transition"
              >
                <p class="text-xs font-black text-amber-300 uppercase tracking-wide mb-2">{post.category}</p>
                <h3 class="text-lg font-black text-white leading-snug">{post.title}</h3>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</SeoLayout>

